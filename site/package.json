{
  "name": "uapfinder-site",
  "version": "0.1.0",
  "private": true,
  "description": "UAP Finder public website: project explainer and volunteer sign-up",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --port 5180",
    "typecheck": "astro check && tsc --noEmit",
    "build": "npm run typecheck && astro build",
    "preview": "astro preview --port 5181",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshot": "playwright test --grep @screenshots",
    "images": "node scripts/render-images.mjs"
  },
  "dependencies": {
    "astro": "7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}

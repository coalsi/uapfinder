---
/**
 * Pointing calibration from the stars: detected stars (dots) against where
 * a bright-star catalogue predicts them (rings), first from the rough prior
 * ("pointing up, heading unknown"), then after the solve. Illustrative star
 * field, generated deterministically.
 */
import { rng } from "../lib/trackfit";

const W = 300;
const H = 210;
const next = rng(42);
const stars = Array.from({ length: 26 }, () => ({
  x: (next() * 2 - 1) * 0.92,
  y: (next() * 2 - 1) * 0.86,
  m: next(),
}));
// The prior is off by a heading error, a tilt and a slightly wrong focal length.
const ROT = (16 * Math.PI) / 180;
const SCALE = 0.9;
const SHIFT = [0.2, -0.14];
const prior = stars.map((s) => ({
  x: SCALE * (s.x * Math.cos(ROT) - s.y * Math.sin(ROT)) + SHIFT[0]!,
  y: SCALE * (s.x * Math.sin(ROT) + s.y * Math.cos(ROT)) + SHIFT[1]!,
  m: s.m,
}));
const px = (x: number) => W / 2 + (x * (W - 20)) / 2;
const py = (y: number) => H / 2 + (y * (H - 20)) / 2;
const inFrame = (p: { x: number; y: number }) => Math.abs(p.x) < 0.98 && Math.abs(p.y) < 0.96;
const f = (n: number) => n.toFixed(1);
// Faint stars (m > 0.8) are in the catalogue but not detected; a few detections are not stars.
const detected = stars.filter((s) => s.m <= 0.8);
const spurious = [
  { x: -0.55, y: 0.62 },
  { x: 0.7, y: -0.2 },
];
const panels = [
  { key: "before", title: "Before: the rough guess", rings: prior },
  { key: "after", title: "After: solved", rings: stars },
];
---
<div class="starcal">
  {
    panels.map((p) => (
      <figure class="diagram starcal-panel">
        <svg viewBox={`0 0 ${W} ${H + 34}`} role="img" aria-labelledby={`starcal-${p.key}-title`}>
          <title id={`starcal-${p.key}-title`}>
            {p.key === "before"
              ? "Before calibration: catalogue stars predicted from a rough guess of the pointing are rotated and shifted away from the stars the camera detects"
              : "After calibration: the catalogue stars fall on the detected stars once yaw, pitch, roll, focal length and distortion are solved"}
          </title>
          <rect x="0.5" y="0.5" width={W - 1} height={H - 1} rx="8" fill="#050911" stroke="#6f7f9e" />
          {p.rings.filter(inFrame).map((s) => (
            <circle cx={f(px(s.x))} cy={f(py(s.y))} r={f(5.5 + (1 - s.m) * 2.5)} class="sc-ring" />
          ))}
          {detected.map((s) => (
            <circle cx={f(px(s.x))} cy={f(py(s.y))} r={f(1.2 + (1 - s.m) * 1.8)} class="sc-dot" />
          ))}
          {spurious.map((s) => (
            <circle cx={f(px(s.x))} cy={f(py(s.y))} r="1.8" class="sc-dot" />
          ))}
          {p.key === "before" &&
            detected.slice(0, 7).map((s, i) => {
              const r = prior[stars.indexOf(s)]!;
              return inFrame(r) ? (
                <line x1={f(px(r.x))} y1={f(py(r.y))} x2={f(px(s.x))} y2={f(py(s.y))} class="sc-link" data-i={i} />
              ) : null;
            })}
          <text x="10" y={H + 24} class="sc-title">
            {p.title}
          </text>
        </svg>
      </figure>
    ))
  }
</div>
<ul class="starcal-key">
  <li><span class="k k-dot" aria-hidden="true"></span> star detected in a stacked night frame</li>
  <li><span class="k k-ring" aria-hidden="true"></span> where the catalogue says a star should be</li>
  <li><span class="k k-link" aria-hidden="true"></span> a tentative match the solver tests</li>
</ul>

<style>
  .starcal {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }

  .starcal-panel {
    margin: 0;
  }

  .starcal-panel svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .sc-ring {
    fill: none;
    stroke: #ffd27a;
    stroke-width: 1.3;
    opacity: 0.85;
  }

  .sc-dot {
    fill: #e8edf6;
  }

  .sc-link {
    stroke: #8fd0ff;
    stroke-width: 1.2;
    stroke-dasharray: 3 3;
  }

  .sc-title {
    fill: var(--text);
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
  }

  .starcal-key {
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    color: var(--text-2);
    font-size: 0.9rem;
  }

  .starcal-key li {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .k {
    display: inline-block;
    flex: none;
  }

  .k-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #e8edf6;
  }

  .k-ring {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1.5px solid #ffd27a;
  }

  .k-link {
    width: 18px;
    border-top: 2px dashed #8fd0ff;
  }
</style>

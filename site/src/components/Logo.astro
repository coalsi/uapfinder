---
/** UAP Finder mark: two ground nodes whose sight lines meet at a target. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path d="M2.5 28.5c8.5-3.2 18.5-3.2 27 0" stroke="#22304d" stroke-width="1.6" stroke-linecap="round"></path>
  <path d="M6 25.2 15.2 9.6M26 25.2 16.8 9.6" stroke="#8fd0ff" stroke-width="1.9" stroke-linecap="round"></path>
  <circle cx="16" cy="8.4" r="6" stroke="#ffd27a" stroke-opacity="0.45" stroke-width="1.2"></circle>
  <circle cx="16" cy="8.4" r="2.6" fill="#ffd27a"></circle>
  <circle cx="6" cy="25.6" r="2.4" fill="#8fd0ff"></circle>
  <circle cx="26" cy="25.6" r="2.4" fill="#8fd0ff"></circle>
</svg>

---
/**
 * Two-node triangulation, drawn from actual geometry at build time: each
 * node's sight line, its angular-uncertainty wedge (exaggerated), and the
 * region where the two wedges overlap, which is what the error model's
 * sigma_m summarises. Numbered markers are explained in an HTML legend so
 * the text stays readable at phone widths.
 */
interface Props {
  legend?: boolean;
  caption?: string;
  id?: string;
}
const { legend = true, caption, id = "triangulation" } = Astro.props;

type P = [number, number];
const A: P = [120, 322];
const B: P = [520, 322];
const O: P = [338, 92];
const HALF = (3.2 * Math.PI) / 180; // exaggerated angular error for visibility

const sub = (p: P, q: P): P => [p[0] - q[0], p[1] - q[1]];
const add = (p: P, q: P): P => [p[0] + q[0], p[1] + q[1]];
const mul = (p: P, k: number): P => [p[0] * k, p[1] * k];
const len = (p: P) => Math.hypot(p[0], p[1]);
const unit = (p: P): P => mul(p, 1 / len(p));
const rot = (p: P, a: number): P => [p[0] * Math.cos(a) - p[1] * Math.sin(a), p[0] * Math.sin(a) + p[1] * Math.cos(a)];
const f = (n: number) => n.toFixed(1);
const pt = (p: P) => `${f(p[0])},${f(p[1])}`;

/** Intersection of lines p + t·u and q + s·v. */
function meet(p: P, u: P, q: P, v: P): P {
  const det = u[0] * -v[1] - u[1] * -v[0];
  const d = sub(q, p);
  const t = (d[0] * -v[1] - d[1] * -v[0]) / det;
  return add(p, mul(u, t));
}

const dA = unit(sub(O, A));
const dB = unit(sub(O, B));
const rA = len(sub(O, A));
const rB = len(sub(O, B));
const wedge = (origin: P, d: P, r: number) => {
  const far = r * 1.32;
  return `M${pt(origin)} L${pt(add(origin, mul(rot(d, -HALF), far)))} L${pt(add(origin, mul(rot(d, HALF), far)))} Z`;
};
const region = [
  meet(A, rot(dA, -HALF), B, rot(dB, -HALF)),
  meet(A, rot(dA, -HALF), B, rot(dB, HALF)),
  meet(A, rot(dA, HALF), B, rot(dB, HALF)),
  meet(A, rot(dA, HALF), B, rot(dB, -HALF)),
];
const regionPath = `M${region.map(pt).join(" L")} Z`;
const rayEnd = (origin: P, d: P, r: number) => add(origin, mul(d, r * 1.32));

// Parallax arc at the object, between the directions back to each node.
const toA = unit(sub(A, O));
const toB = unit(sub(B, O));
const ARC_R = 40;
const arcStart = add(O, mul(toA, ARC_R));
const arcEnd = add(O, mul(toB, ARC_R));

// Ground: a gently curved horizon.
const groundY = (x: number) => {
  const t = x / 640;
  return 340 - 56 * t * (1 - t);
};

const normalA: P = [dA[1], -dA[0]]; // left of ray A (outside the triangle)
const normalB: P = [-dB[1], dB[0]]; // right of ray B
const m1 = add(add(A, mul(dA, rA * 0.5)), mul(normalA, 24));
const m2 = add(add(B, mul(dB, rB * 0.55)), mul(normalB, 26));
const m3: P = [O[0] + 46, O[1] + 4];
const m4: P = [O[0] + 22, O[1] + ARC_R + 30];
const m5: P = [O[0] - 26, (O[1] + groundY(O[0])) / 2 + 40];

const stars: [number, number, number][] = [
  [42, 40, 1.2], [96, 120, 0.9], [182, 30, 1.4], [230, 160, 0.8], [470, 36, 1.1],
  [560, 120, 1.3], [604, 52, 0.9], [420, 190, 0.8], [36, 220, 0.9], [610, 230, 1],
  [280, 26, 0.8], [150, 252, 0.7],
];
const markers: [P, string][] = [
  [m1, "1"], [m2, "2"], [m3, "3"], [m4, "4"], [m5, "5"],
];
const titleId = `${id}-title`;
const descId = `${id}-desc`;
---
<figure class="diagram tri">
  <svg viewBox="0 0 640 400" role="img" aria-labelledby={`${titleId} ${descId}`}>
    <title id={titleId}>Stereo triangulation with two ground nodes</title>
    <desc id={descId}>
      Two cameras, node A and node B, sit on the ground several miles apart. Each draws a line of sight to the
      same object in the sky, surrounded by a narrow wedge of angular uncertainty. The lines cross at the object;
      the small diamond where the wedges overlap is the position uncertainty. The angle between the sight lines
      at the object is the parallax, and a dashed line from the object to the ground marks its altitude.
    </desc>
    <defs>
      <radialGradient id={`${id}-glow`}>
        <stop offset="0" stop-color="#ffd27a" stop-opacity="0.55"></stop>
        <stop offset="1" stop-color="#ffd27a" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id={`${id}-ground`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#121c30"></stop>
        <stop offset="1" stop-color="#0a111e"></stop>
      </linearGradient>
    </defs>

    {stars.map(([x, y, r]) => <circle cx={x} cy={y} r={r} fill="#c9d6ec" opacity="0.7" />)}

    <path d={wedge(A, dA, rA)} fill="#8fd0ff" fill-opacity="0.13"></path>
    <path d={wedge(B, dB, rB)} fill="#8fd0ff" fill-opacity="0.13"></path>
    <line x1={f(A[0])} y1={f(A[1])} x2={f(rayEnd(A, dA, rA)[0])} y2={f(rayEnd(A, dA, rA)[1])} stroke="#8fd0ff" stroke-width="2" stroke-linecap="round"></line>
    <line x1={f(B[0])} y1={f(B[1])} x2={f(rayEnd(B, dB, rB)[0])} y2={f(rayEnd(B, dB, rB)[1])} stroke="#8fd0ff" stroke-width="2" stroke-linecap="round"></line>

    <line x1={O[0]} y1={O[1] + ARC_R + 4} x2={O[0]} y2={f(groundY(O[0]))} stroke="#8e9bb2" stroke-width="1.5" stroke-dasharray="5 6"></line>
    <path
      d={`M${pt(arcStart)} A${ARC_R} ${ARC_R} 0 0 0 ${pt(arcEnd)}`}
      fill="none"
      stroke="#ffd27a"
      stroke-width="1.6"
    ></path>

    <circle cx={O[0]} cy={O[1]} r="26" fill={`url(#${id}-glow)`}></circle>
    <path d={regionPath} fill="#ffd27a" fill-opacity="0.3" stroke="#ffd27a" stroke-width="1.4" stroke-linejoin="round"></path>
    <circle cx={O[0]} cy={O[1]} r="3.4" fill="#ffd27a"></circle>

    <path d={`M0 340 Q320 312 640 340 L640 400 L0 400 Z`} fill={`url(#${id}-ground)`}></path>
    <path d="M0 340 Q320 312 640 340" fill="none" stroke="#2a3958" stroke-width="1.5"></path>

    {
      [A, B].map((p) => (
        <g>
          <rect x={p[0] - 11} y={p[1] + 2} width="22" height="9" rx="2" fill="#22304d" />
          <path d={`M${p[0] - 9} ${p[1] + 3} a9 9 0 0 1 18 0 Z`} fill="#8fd0ff" />
        </g>
      ))
    }

    <g class="tri-text">
      <text x={A[0]} y="364" text-anchor="middle">Node A</text>
      <text x={B[0]} y="364" text-anchor="middle">Node B</text>
      <text x={O[0] - 40} y={O[1] + 7} text-anchor="end" class="tri-object">object</text>
    </g>
    <g class="tri-baseline">
      <line x1={A[0]} y1="384" x2={B[0]} y2="384" stroke="#6f7f9e" stroke-width="1.2"></line>
      <path d={`M${A[0] + 8} 379 L${A[0]} 384 L${A[0] + 8} 389 M${B[0] - 8} 379 L${B[0]} 384 L${B[0] - 8} 389`} fill="none" stroke="#6f7f9e" stroke-width="1.2"></path>
      <rect x={320 - 74} y="372" width="148" height="24" rx="4" fill="#0c1424"></rect>
      <text x="320" y="390" text-anchor="middle">5–40 miles</text>
    </g>

    {
      markers.map(([p, n]) => (
        <g class="tri-marker">
          <circle cx={f(p[0])} cy={f(p[1])} r="13" />
          <text x={f(p[0])} y={f(p[1] + 5.5)} text-anchor="middle">
            {n}
          </text>
        </g>
      ))
    }
  </svg>
  {
    legend && (
      <ol class="tri-legend">
        <li>
          <strong>Line of sight.</strong> Each node measures only a direction to the object: its azimuth and
          elevation, to about 0.01–0.05° when the camera is calibrated against the stars.
        </li>
        <li>
          <strong>Angular uncertainty.</strong> A small angular error becomes a sideways position error that grows
          with distance: range × angle.
        </li>
        <li>
          <strong>Position and its error.</strong> Where the sight lines cross is the estimate; the overlap of the
          two wedges is its uncertainty, published as <code>sigma_m</code>.
        </li>
        <li>
          <strong>Parallax.</strong> The angle between the sight lines at the object. Larger parallax pins down
          distance better, which is why nodes need to be miles apart.
        </li>
        <li>
          <strong>Altitude.</strong> Follows directly from the 3D position. Successive fixes, ten per second, give
          speed and acceleration.
        </li>
      </ol>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .tri svg {
    background:
      radial-gradient(90% 80% at 55% 10%, rgb(92 184 255 / 0.08), transparent 70%),
      var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .tri-text text,
  .tri-baseline text {
    fill: var(--text-2);
    font-family: var(--font-sans);
    font-size: 21px;
    font-weight: 500;
  }

  .tri-object {
    fill: var(--star) !important;
  }

  .tri-marker circle {
    fill: var(--bg);
    stroke: var(--star);
    stroke-width: 1.5;
  }

  .tri-marker text {
    fill: var(--star);
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
  }

  .tri-legend {
    margin: 16px 0 0;
    padding-left: 1.6em;
    color: var(--text-2);
    font-size: 0.95rem;
    display: grid;
    gap: 6px;
  }

  .tri-legend li {
    margin: 0;
    padding-left: 4px;
  }

  .tri-legend li::marker {
    color: var(--star);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .tri-legend strong {
    color: var(--text);
  }
</style>

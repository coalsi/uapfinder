---
import { API_BASE, sitePath } from "../config";
import { countryOptions } from "../lib/countries";
import { LIMITS, outcomeMessage } from "../lib/volunteer";

const countries = countryOptions();
const success = outcomeMessage({ kind: "success" });

const siteTypes = [
  { value: "", label: "Not sure yet" },
  { value: "rooftop", label: "Rooftop" },
  { value: "yard", label: "Yard or garden" },
  { value: "rural_land", label: "Rural land" },
  { value: "other", label: "Other" },
];
const hardware = [
  { value: "", label: "Prefer not to say" },
  { value: "none", label: "None yet" },
  { value: "some", label: "Some of the parts" },
  { value: "full", label: "A complete node" },
];
const interests = [
  { value: "host_node", label: "Host a node", hint: "Run a camera at your home or land." },
  { value: "software", label: "Software", hint: "Edge, server, map or website code." },
  { value: "data_analysis", label: "Data analysis", hint: "Check tracks, filters and the error model." },
  { value: "outreach", label: "Outreach", hint: "Help find hosts, especially in rural areas." },
];
---
<div class="signup">
  <form
    id="signup-form"
    class="form"
    novalidate
    data-volunteer-form
    data-api-base={API_BASE}
    aria-labelledby="signup-title"
    aria-describedby="signup-intro"
  >
    <div class="error-summary" data-error-summary tabindex="-1" role="alert" hidden>
      <p class="status-title">Please check the following:</p>
      <ul></ul>
    </div>

    <fieldset>
      <legend>About you</legend>
      <div class="field" data-group="email">
        <label for="f-email">Email <span class="req">(required)</span></label>
        <input
          id="f-email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          maxlength={LIMITS.email}
          required
          aria-describedby="f-email-hint f-email-err"
        />
        <p class="hint" id="f-email-hint">Only used to contact you about UAP Finder.</p>
        <p class="field-error" id="f-email-err" data-error-for="email" hidden></p>
      </div>
      <div class="field" data-group="name">
        <label for="f-name">Name <span class="opt">(optional)</span></label>
        <input id="f-name" name="name" type="text" autocomplete="name" maxlength={LIMITS.name} aria-describedby="f-name-err" />
        <p class="field-error" id="f-name-err" data-error-for="name" hidden></p>
      </div>
    </fieldset>

    <fieldset>
      <legend>Roughly where you are</legend>
      <p class="fieldset-hint">
        We never ask for a street address. Your country is required; the rest helps us plan where nodes are needed.
      </p>
      <div class="field" data-group="country">
        <label for="f-country">Country <span class="req">(required)</span></label>
        <select id="f-country" name="country" autocomplete="country" required aria-describedby="f-country-err">
          <option value="">Choose a country</option>
          {countries.map((c) => <option value={c.code}>{c.name}</option>)}
        </select>
        <p class="field-error" id="f-country-err" data-error-for="country" hidden></p>
      </div>
      <div class="row-3">
        <div class="field" data-group="region">
          <label for="f-region">State or region <span class="opt">(optional)</span></label>
          <input id="f-region" name="region" type="text" autocomplete="address-level1" maxlength={LIMITS.region} aria-describedby="f-region-err" />
          <p class="field-error" id="f-region-err" data-error-for="region" hidden></p>
        </div>
        <div class="field" data-group="city">
          <label for="f-city">City or town <span class="opt">(optional)</span></label>
          <input id="f-city" name="city" type="text" autocomplete="address-level2" maxlength={LIMITS.city} aria-describedby="f-city-err" />
          <p class="field-error" id="f-city-err" data-error-for="city" hidden></p>
        </div>
        <div class="field" data-group="postal_code">
          <label for="f-postal">Postal code <span class="opt">(optional)</span></label>
          <input id="f-postal" name="postal_code" type="text" autocomplete="postal-code" maxlength={LIMITS.postal_code} aria-describedby="f-postal-err" />
          <p class="field-error" id="f-postal-err" data-error-for="postal_code" hidden></p>
        </div>
      </div>
      <div class="field geo" data-group="location">
        <p class="label-like" id="geo-label">Approximate location <span class="opt">(optional)</span></p>
        <p class="hint" id="geo-hint">
          Your browser will ask for permission. The coordinates are rounded to two decimal places (about 1 km) on your
          device before they are put into this form, and are sent only when you submit.
        </p>
        <div class="geo-actions">
          <button class="btn btn-secondary" type="button" id="f-geo" data-geo-button aria-describedby="geo-label geo-hint geo-out f-geo-err">
            Use my approximate location
          </button>
          <button class="link-button" type="button" data-geo-clear hidden>Remove location</button>
        </div>
        <p class="geo-out" id="geo-out" data-geo-output aria-live="polite"></p>
        <input type="hidden" name="approx_lat" value="" />
        <input type="hidden" name="approx_lon" value="" />
        <p class="field-error" id="f-geo-err" data-error-for="location" hidden></p>
      </div>
    </fieldset>

    <fieldset>
      <legend>Your site and hardware</legend>
      <div class="field" data-group="site_type">
        <fieldset class="inner">
          <legend class="label-like">Where would a camera go? <span class="opt">(optional)</span></legend>
          <div class="choices">
            {
              siteTypes.map((s, i) => (
                <label class="choice">
                  <input type="radio" name="site_type" value={s.value} checked={i === 0} />
                  <span>{s.label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <p class="field-error" data-error-for="site_type" hidden></p>
      </div>
      <div class="field" data-group="has_hardware">
        <fieldset class="inner">
          <legend class="label-like">Do you already have hardware? <span class="opt">(optional)</span></legend>
          <div class="choices">
            {
              hardware.map((h, i) => (
                <label class="choice">
                  <input type="radio" name="has_hardware" value={h.value} checked={i === 0} />
                  <span>{h.label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <p class="field-error" data-error-for="has_hardware" hidden></p>
      </div>
    </fieldset>

    <fieldset>
      <legend>How you'd like to help</legend>
      <div class="field" data-group="interests">
        <div class="choices choices--cards">
          {
            interests.map((it) => (
              <label class="choice card-choice">
                <input type="checkbox" name="interests" value={it.value} />
                <span>
                  <strong>{it.label}</strong>
                  <span class="choice-hint">{it.hint}</span>
                </span>
              </label>
            ))
          }
        </div>
        <p class="field-error" data-error-for="interests" hidden></p>
      </div>
      <div class="field" data-group="notes">
        <label for="f-notes">Anything else? <span class="opt">(optional)</span></label>
        <textarea
          id="f-notes"
          name="notes"
          rows="4"
          aria-describedby="f-notes-hint f-notes-err"
          placeholder="For example: clear view to the south-west, power on the roof, nearest town."
        ></textarea>
        <p class="hint counter-row" id="f-notes-hint">
          <span>Please don't include your street address.</span>
          <span class="counter" data-notes-counter aria-hidden="true">0 / {LIMITS.notes}</span>
        </p>
        <p class="field-error" id="f-notes-err" data-error-for="notes" hidden></p>
      </div>
    </fieldset>

    <div class="hp" aria-hidden="true">
      <label for="f-website">Leave this field empty</label>
      <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" value="" />
    </div>

    <div class="field consent" data-group="consent">
      <label class="choice">
        <input type="checkbox" name="consent" id="f-consent" required aria-describedby="f-consent-err" />
        <span>
          I agree that UAP Finder may store these details and contact me about the project, as described in the
          <a href={sitePath("/privacy/")}>privacy notice</a>. <span class="req">(required)</span>
        </span>
      </label>
      <p class="field-error" id="f-consent-err" data-error-for="consent" hidden></p>
    </div>

    <div class="submit-row">
      <button class="btn btn-primary" type="submit" disabled>Register interest</button>
      <p class="small muted">Nothing is sent until you press this button.</p>
    </div>
    <noscript>
      <p class="callout callout--warn">This form needs JavaScript so that it can check your entries before anything is sent.</p>
    </noscript>

    <div class="form-status" data-form-status role="alert" tabindex="-1" hidden></div>
  </form>

  <div class="form-success" data-form-success tabindex="-1" role="status" hidden>
    <svg viewBox="0 0 32 32" width="36" height="36" aria-hidden="true" focusable="false"><circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="m10 16.5 4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    <p class="status-title">{success.title}</p>
    <p>{success.body}</p>
    <p><a href={sitePath("/host/")}>Read about hosting a node</a> or <a href={sitePath("/how-it-works/")}>how the system works</a>.</p>
  </div>
</div>

<script>
  import { initVolunteerForm } from "../scripts/volunteer-form";
  initVolunteerForm();
</script>

<style>
  .form {
    display: grid;
    gap: 22px;
  }

  fieldset {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 18px clamp(16px, 3vw, 24px) 6px;
    margin: 0;
    background: var(--surface);
    min-width: 0;
  }

  fieldset > legend {
    font-weight: 650;
    padding: 0 8px;
    margin-left: -8px;
    font-size: 1.05rem;
  }

  fieldset.inner {
    border: 0;
    padding: 0;
    background: none;
  }

  fieldset.inner > legend {
    padding: 0;
    margin: 0 0 8px;
  }

  .fieldset-hint {
    color: var(--text-2);
    font-size: 0.93rem;
    margin: 4px 0 14px;
  }

  .field {
    margin-bottom: 18px;
    min-width: 0;
  }

  label,
  .label-like {
    display: block;
    font-weight: 600;
    font-size: 0.97rem;
    margin: 0 0 6px;
    color: var(--text);
  }

  .req,
  .opt {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.88rem;
  }

  input[type="text"],
  input[type="email"],
  select,
  textarea {
    display: block;
    width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    padding: 11px 12px;
    min-height: 46px;
  }

  textarea {
    resize: vertical;
    min-height: 110px;
    line-height: 1.5;
  }

  select {
    appearance: none;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--text-2) 50%),
      linear-gradient(135deg, var(--text-2) 50%, transparent 50%);
    background-position: calc(100% - 20px) 50%, calc(100% - 14px) 50%;
    background-size: 6px 6px;
    background-repeat: no-repeat;
    padding-right: 40px;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }

  ::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  [aria-invalid="true"]:is(input, select, textarea) {
    border-color: var(--err);
  }

  .hint {
    color: var(--muted);
    font-size: 0.88rem;
    margin: 6px 0 0;
  }

  .counter-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .counter {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .counter.over {
    color: var(--err);
  }

  .field-error {
    color: var(--err);
    font-size: 0.9rem;
    margin: 6px 0 0;
    font-weight: 500;
  }

  .field-error::before {
    content: "! ";
    font-weight: 700;
  }

  .row-3 {
    display: grid;
    gap: 0 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
  }

  .geo-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-top: 10px;
  }

  .geo-out {
    margin: 8px 0 0;
    color: var(--text-2);
    font-size: 0.92rem;
    min-height: 1.4em;
  }

  .link-button {
    background: none;
    border: 0;
    padding: 6px 2px;
    color: var(--accent);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .choice {
    display: inline-flex;
    align-items: flex-start;
    gap: 10px;
    font-weight: 400;
    margin: 0;
    cursor: pointer;
  }

  .choices .choice {
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    padding: 9px 14px;
    background: var(--bg);
    min-height: 44px;
    align-items: center;
  }

  .choices .choice:has(input:checked) {
    border-color: var(--accent);
    background: var(--accent-wash);
  }

  .choices .choice:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .choices--cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }

  .choices--cards .card-choice {
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    align-items: flex-start;
  }

  .choice-hint {
    display: block;
    color: var(--muted);
    font-size: 0.88rem;
    margin-top: 2px;
  }

  input[type="checkbox"],
  input[type="radio"] {
    accent-color: var(--accent-strong);
    width: 18px;
    height: 18px;
    margin: 3px 0 0;
    flex: none;
  }

  .choices input[type="radio"] {
    margin-top: 0;
  }

  .consent {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px clamp(16px, 3vw, 24px);
    margin: 0;
  }

  .consent .choice span {
    color: var(--text-2);
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .submit-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
  }

  .submit-row p {
    margin: 0;
  }

  .error-summary,
  .form-status,
  .form-success {
    border: 1px solid var(--line);
    border-left: 4px solid var(--err);
    border-radius: var(--radius-sm);
    padding: 14px 18px;
    background: var(--surface);
  }

  /* The summary items and status messages are created by the form script,
     so they need :global() to receive these (otherwise scoped) styles. */
  .error-summary ul {
    margin: 0;
  }

  .error-summary :global(a) {
    color: var(--err);
  }

  .form-status[data-tone="warning"] {
    border-left-color: var(--warn);
  }

  .form-status :global(p),
  .form-success p {
    margin: 0 0 6px;
  }

  .form-status :global(p:last-child),
  .form-success p:last-child {
    margin-bottom: 0;
  }

  :global(.signup) :global(.status-title) {
    font-weight: 650;
    color: var(--text);
    margin: 0 0 6px;
  }

  .form-success {
    border-left-color: var(--ok);
    padding: 24px;
  }

  .form-success svg {
    color: var(--ok);
    margin-bottom: 8px;
  }

  .form-success .status-title {
    font-size: 1.2rem;
  }

  .error-summary:focus,
  .form-status:focus,
  .form-success:focus {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>

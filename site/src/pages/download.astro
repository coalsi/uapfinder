---
import Base from "../layouts/Base.astro";
import { downloads, links, NODE_IMAGE_NAME, nvidia, REPO_URL, sitePath } from "../config";

const description =
  "Download the UAP Finder software: the ready-to-flash node system image for a Jetson Orin Nano, the source code, the server for a Mac or Linux machine, and a simulator to try it without hardware.";

interface Part {
  path: string;
  what: string;
  who: string;
  guide: string;
  guideLabel: string;
}

const contents: Part[] = [
  {
    path: "edge/",
    what: "Camera-node software for the Jetson: detection, tracking, filters, uplink, setup script and system service",
    who: "Node hosts",
    guide: links.edgeGuide,
    guideLabel: "Edge guide",
  },
  {
    path: "server/",
    what: "Ingest, matching, triangulation, 3D tracks, clip requests, database and HTTP API",
    who: "Network coordinators",
    guide: links.serverGuide,
    guideLabel: "Server guide",
  },
  {
    path: "deploy/",
    what: "Running the server on a Mac Studio with Tailscale, and a Docker setup for Linux",
    who: "Network coordinators",
    guide: links.macStudioGuide,
    guideLabel: "Mac Studio guide",
  },
  {
    path: "common/",
    what: "Shared geometry, triangulation and the signed message format (installed automatically)",
    who: "Everyone",
    guide: links.mathDoc,
    guideLabel: "Error model",
  },
  {
    path: "tools/",
    what: "A simulated network with known targets that scores the server's tracks",
    who: "Testers",
    guide: `${REPO_URL}/blob/HEAD/tools/simulate_network.py`,
    guideLabel: "Simulator",
  },
  {
    path: "dashboard/, site/",
    what: "The live 3D map and this website",
    who: "Developers",
    guide: links.dashboardCode,
    guideLabel: "Map code",
  },
];

const nodeInstall = `sudo apt-get update && sudo apt-get install -y git
git clone ${REPO_URL}.git
cd uapfinder
sudo ./edge/deploy/jetson/setup.sh`;

const nodeCheck = `journalctl -u skynet-edge -f        # live status, a line every minute
sudo -u skynet /opt/skynet/venv/bin/skynet-edge bench --config /etc/skynet/edge.yaml`;

const macServer = `brew install python@3.13 postgresql@17 postgis
git clone ${REPO_URL}.git && cd uapfinder
python3.13 -m venv server/.venv
server/.venv/bin/pip install -e ./common -e ./server
cp server/.env.example server/.env        # set the keys and addresses (see the guide)
server/.venv/bin/skynet-server --env-file server/.env migrate
server/.venv/bin/skynet-server --env-file server/.env serve`;

const dockerServer = `git clone ${REPO_URL}.git && cd uapfinder
cp server/.env.example server/.env        # set SKYNET_MASTER_KEY, SKYNET_ADMIN_TOKEN,
                                          # SKYNET_PUBLIC_URL (openssl rand -hex 32 makes a key)
echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)" > .env
docker compose up -d --build`;

const simulate = `git clone ${REPO_URL}.git && cd uapfinder
python3 -m venv .venv && .venv/bin/pip install -e ./common -e ./server
export SKYNET_MASTER_KEY=$(.venv/bin/skynet-server keygen) SKYNET_ADMIN_TOKEN=$(openssl rand -hex 24)
export SKYNET_PUBLIC_URL=http://127.0.0.1:8000
.venv/bin/skynet-server serve &
.venv/bin/python tools/simulate_network.py --udp 127.0.0.1:9999 \\
    --api http://127.0.0.1:8000 --master-key "$SKYNET_MASTER_KEY" --duration 30`;
---
<Base title="Download and set up" description={description}>
  <header class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Download</p>
      <h1>Get the software</h1>
      <p class="lead">
        Node hosts need one file: the UAP Finder system image, written to a microSD card. Everything else UAP Finder
        runs, from the server that triangulates to the live map and this website, is in one open repository.
      </p>
      <div class="btn-row">
        <a class="btn btn-primary" href={downloads.nodeImage}>Get the node image</a>
        <a class="btn btn-secondary" href={downloads.zip} data-download="zip">Download source ZIP</a>
        <a class="btn btn-secondary" href={REPO_URL}>View on GitHub</a>
      </div>
      <p class="small muted alt-downloads">
        Also as a <a href={downloads.tarball}>.tar.gz archive</a>, or with git:
        <code>{downloads.clone}</code>
      </p>
      <nav aria-label="On this page">
        <ul class="toc">
          <li><a href="#node">Node image</a></li>
          <li><a href="#contents">What's inside</a></li>
          <li><a href="#server">Run the server</a></li>
          <li><a href="#try">Try it without hardware</a></li>
          <li><a href="#requirements">Requirements</a></li>
          <li><a href="#third-party">Other downloads</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <section class="section section--tight" aria-label="Software status">
    <div class="wrap">
      <div class="callout callout--warn">
        <p>
          <strong>Early software.</strong> It is built and tested in simulation, and the server has been run end to
          end with a simulated network. The node system image is new: it is built and tested automatically, but has
          not yet been booted on a real Orin Nano, and the camera, GPS and orientation-sensor code follows the
          manufacturers' documentation without having run on a real device yet. Expect some troubleshooting, and
          please <a href={links.issues}>report what you find</a>.
        </p>
      </div>
    </div>
  </section>

  <section id="node" class="section anchor-section" aria-labelledby="node-title">
    <div class="wrap split split--wide-left split--top">
      <div>
        <h2 id="node-title">Set up a camera node</h2>
        <p>
          For hosts with a Jetson Orin Nano developer kit, a camera and a GPS receiver. The node runs from a
          ready-made system image: flash it, plug the parts together and finish setup from your phone.
        </p>
        <ol class="steps">
          <li>
            <h3>Download the image</h3>
            <p>
              From the <a href={downloads.nodeImage}>latest release</a>, download
              <code class="wrap-code">{NODE_IMAGE_NAME}</code> (under 2 GB) and its SHA-256 checksum.
            </p>
          </li>
          <li>
            <h3>Write it to a microSD card</h3>
            <p>
              Use <a href="https://etcher.balena.io/">balenaEtcher</a> and a 64 GB or larger A2 card. Etcher reads the
              compressed <code>.img.xz</code> directly and verifies the card afterwards.
            </p>
          </li>
          <li>
            <h3>Follow the build guide</h3>
            <p>
              The <a href={sitePath("/build/")}>step-by-step guide</a> covers the one-time firmware check for new
              developer kits, the wiring, the enclosure, and claiming the node with the code from your network
              coordinator.
            </p>
          </li>
        </ol>
        <p class="btn-row">
          <a class="btn btn-primary" href={downloads.nodeImage}>Get the node image</a>
          <a class="btn btn-secondary" href={sitePath("/build/")}>Build guide</a>
        </p>
        <div class="callout callout--warn">
          <p>
            <strong>New, not yet hardware-tested.</strong> Booting the image on a real Orin Nano, the CSI camera setup,
            PPS on pin 7 and the Wi-Fi hotspot still need to be confirmed on a real device.
          </p>
        </div>

        <h3 id="command-line">Alternative: the command-line installer</h3>
        <p>
          Already running NVIDIA JetPack 6? The installer produces the same system as the image, including the setup
          page. On the Jetson, in a terminal:
        </p>
        <pre tabindex="0"><code>{nodeInstall}</code></pre>
        <p class="small muted">
          Then claim the node at <code>http://uapfinder.local</code> as in the
          <a href={sitePath("/build/#setup")}>build guide</a>. To check the detection pipeline from a terminal:
        </p>
        <pre tabindex="0"><code>{nodeCheck}</code></pre>
        <p class="small muted">Options and configuration are in the <a href={links.edgeGuide}>edge guide</a>.</p>
      </div>
      <aside class="card" aria-labelledby="image-contents-title">
        <h3 id="image-contents-title">What's on the image</h3>
        <ul>
          <li>NVIDIA Jetson Linux R36.5.2 (JetPack 6.2.3, Ubuntu 22.04) for the Orin Nano developer kit, with NVIDIA's camera, GStreamer and multimedia stack. No desktop.</li>
          <li>The UAP Finder node software and its automatic star calibration.</li>
          <li>The setup and status page at <code>http://uapfinder.local</code>, and a Wi-Fi hotspot for setup without a network.</li>
          <li>GPS time with gpsd and chrony, set up for PPS on header pin 7; the IMX477 camera set up on CAM0.</li>
          <li>Tailscale, readsb for an ADS-B receiver, ffmpeg.</li>
          <li>SSH stays off until you set the device password.</li>
        </ul>
        <h3 class="files-title">Files you'll use</h3>
        <ul>
          <li><a href={sitePath("/build/")}>Build guide</a> and <a href={sitePath("/device/")}>how the node works</a></li>
          <li><a href={links.edgeGuide}>Edge guide</a>: software, configuration and checks</li>
          <li><a href={links.jetsonImageGuide}>Image guide</a>: how the image is built</li>
          <li><a href={links.jetsonSetupScript}>Setup script</a></li>
        </ul>
      </aside>
    </div>
  </section>

  <section id="contents" class="section anchor-section" aria-labelledby="contents-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="contents-title">What's inside the download</h2>
        <p>One archive holds every part. Most people only need one folder and its guide.</p>
      </div>
      <div class="table-wrap" tabindex="0" role="region" aria-labelledby="contents-caption">
        <table class="table-stack contents">
          <caption id="contents-caption">Folders in the repository and who uses them</caption>
          <thead>
            <tr>
              <th scope="col">Folder</th>
              <th scope="col">What it is</th>
              <th scope="col">For</th>
              <th scope="col">Guide</th>
            </tr>
          </thead>
          <tbody>
            {
              contents.map((c) => (
                <tr>
                  <th scope="row"><code>{c.path}</code></th>
                  <td data-label="What it is">{c.what}</td>
                  <td data-label="For">{c.who}</td>
                  <td data-label="Guide"><a href={c.guide}>{c.guideLabel}</a></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="server" class="section anchor-section" aria-labelledby="server-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="server-title">Run the server</h2>
        <p>
          For network coordinators. One server collects every node's sightings, triangulates them and serves the
          live map. Nodes reach it over Tailscale (no open router ports) or over the internet.
        </p>
      </div>
      <div class="grid grid-2">
        <article class="card">
          <h3>On a Mac (Mac Studio)</h3>
          <p>
            The planned setup: the server and database on a Mac at home, nodes connected over Tailscale, and the public
            API published with Tailscale Funnel. <a href={links.macStudioGuide}>Mac Studio guide</a>.
          </p>
          <pre tabindex="0"><code>{macServer}</code></pre>
        </article>
        <article class="card">
          <h3>On a Linux server (Docker)</h3>
          <p>
            The server and PostGIS database in containers, for a VPS or a spare machine. Put HTTPS in front of port 8000
            for public access. <a href={links.serverGuide}>Server guide</a>.
          </p>
          <pre tabindex="0"><code>{dockerServer}</code></pre>
        </article>
      </div>
    </div>
  </section>

  <section id="try" class="section anchor-section" aria-labelledby="try-title">
    <div class="wrap split split--wide-left split--top">
      <div>
        <h2 id="try-title">Try it without hardware</h2>
        <p>
          A simulated network of six cameras watches three objects with known paths, including a Mach 6 one. It
          sends real signed messages to a local server, then scores the server's 3D tracks against the truth. You
          need Python 3.10 or later.
        </p>
        <pre tabindex="0"><code>{simulate}</code></pre>
        <p class="small muted">
          Expect median position errors of roughly 10–20 m, and the hypersonic and high-g objects flagged as such.
        </p>
      </div>
      <aside class="card" aria-labelledby="demo-title">
        <h3 id="demo-title">Or just look</h3>
        <p>The live map has a built-in demo network around Phoenix, Arizona, clearly labelled as demo data.</p>
        <p><a class="btn btn-secondary" href={links.map}>Open the live map</a></p>
      </aside>
    </div>
  </section>

  <section id="requirements" class="section anchor-section" aria-labelledby="req-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="req-title">Requirements</h2>
      </div>
      <div class="table-wrap" tabindex="0" role="region" aria-labelledby="req-caption">
        <table class="table-stack">
          <caption id="req-caption">Software requirements by component</caption>
          <thead>
            <tr>
              <th scope="col">Component</th>
              <th scope="col">Runs on</th>
              <th scope="col">Needs</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Camera node</th>
              <td data-label="Runs on">Jetson Orin Nano 8 GB developer kit</td>
              <td data-label="Needs">The UAP Finder image on a 64 GB+ microSD card (or JetPack 6.x with the command-line installer), camera, GPS with PPS; NVMe SSD recommended</td>
            </tr>
            <tr>
              <th scope="row">Server</th>
              <td data-label="Runs on">macOS or Linux</td>
              <td data-label="Needs">Python 3.10+ (3.12 or 3.13 recommended), PostgreSQL 16–18 with PostGIS 3</td>
            </tr>
            <tr>
              <th scope="row">Simulator</th>
              <td data-label="Runs on">macOS, Linux or Windows (WSL)</td>
              <td data-label="Needs">Python 3.10+</td>
            </tr>
            <tr>
              <th scope="row">Map and website (building)</th>
              <td data-label="Runs on">Any</td>
              <td data-label="Needs">Node.js 22</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="third-party" class="section anchor-section" aria-labelledby="tp-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="tp-title">Other downloads you may need</h2>
        <p>These come from their makers, not from this project.</p>
      </div>
      <div class="grid grid-3">
        <article class="card">
          <h3>NVIDIA JetPack</h3>
          <p>Only needed for the one-time firmware update of older developer kits (the JetPack 5.1.3 SD-card image) or for the command-line install.</p>
          <p><a href={nvidia.jetpack}>JetPack downloads</a> ·
            <a href={nvidia.gettingStarted}>Getting started</a></p>
        </article>
        <article class="card">
          <h3>balenaEtcher</h3>
          <p>Writes the UAP Finder image (and, if needed, NVIDIA's firmware-update image) to a microSD card from macOS, Windows or Linux.</p>
          <p><a href="https://etcher.balena.io/">Download Etcher</a></p>
        </article>
        <article class="card">
          <h3>Tailscale</h3>
          <p>Private network between the nodes and the server, with no open router ports.</p>
          <p><a href="https://tailscale.com/download">Download Tailscale</a></p>
        </article>
        <article class="card">
          <h3>Homebrew</h3>
          <p>Installs Python, PostgreSQL and PostGIS on a Mac running the server.</p>
          <p><a href="https://brew.sh/">Install Homebrew</a></p>
        </article>
        <article class="card">
          <h3>Docker</h3>
          <p>Runs the server and database in containers on Linux.</p>
          <p><a href="https://docs.docker.com/engine/install/">Install Docker Engine</a></p>
        </article>
        <article class="card">
          <h3>Python and Node.js</h3>
          <p>For running the server or simulator, and for building the map and website yourself.</p>
          <p><a href="https://www.python.org/downloads/">Python</a> · <a href="https://nodejs.org/en/download">Node.js</a></p>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  .alt-downloads code {
    white-space: normal;
    word-break: break-all;
  }

  .contents {
    min-width: 720px;
  }

  .card pre {
    margin: 14px 0 0;
    font-size: 0.82rem;
  }

  pre {
    white-space: pre;
  }

  .wrap-code {
    white-space: normal !important;
    word-break: break-all;
  }

  .files-title {
    margin-top: 1.2em;
  }
</style>

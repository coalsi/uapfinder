# Copy to .env for local overrides. All are optional and read at build time.

# Absolute origin of the deployed site, used for canonical/OpenGraph URLs and
# the sitemap. On Vercel it defaults to https://$VERCEL_PROJECT_PRODUCTION_URL.
# PUBLIC_SITE_URL=https://uapfinder.example

# Source repository (links to code, docs, the edge README and issues).
# PUBLIC_REPO_URL=https://github.com/coalsi/uapfinder

# Contact address shown on the privacy page and footer. Leave unset to hide
# all contact-email UI (deletion requests then go through the repository).
# PUBLIC_CONTACT_EMAIL=

# Base URL of the UAP Finder server API (no trailing /api/v1). Empty means the
# same origin as the site. The server must allow this site in SKYNET_CORS_ORIGINS
# when it is on another origin.
# PUBLIC_API_BASE=

# Where the live 3D map is served. The coverage layer is linked as
# ${PUBLIC_MAP_URL}?layer=coverage
# PUBLIC_MAP_URL=/map/

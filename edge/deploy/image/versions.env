# What edge/deploy/image/build-image.sh builds on. Sourced by bash.
# To move to another Jetson Linux release, change this file (README.md,
# "Changing the base version") and run the workflow.

# Jetson Linux R36.5.2 = JetPack 6.2.3 (Ubuntu 22.04, kernel 5.15).
L4T_VERSION=36.5.2
JETPACK_VERSION=6.2.3
UBUNTU_CODENAME=jammy

# NVIDIA's download locations for this release. NVIDIA's own pages link the
# developer.nvidia.com path (file names with a lower-case "r"); the
# developer.download.nvidia.com path (upper-case "R") serves the same files.
# Every combination is tried; whatever downloads must match the pins below.
L4T_URL_BASES="https://developer.nvidia.com/downloads/embedded/l4t/r36_release_v5.2/releases https://developer.download.nvidia.com/embedded/L4T/r36_Release_v5.2/releases"
BSP_NAMES="Jetson_Linux_R36.5.2_aarch64.tbz2 Jetson_Linux_r36.5.2_aarch64.tbz2"
ROOTFS_NAMES="Tegra_Linux_Sample-Root-Filesystem_R36.5.2_aarch64.tbz2 Tegra_Linux_Sample-Root-Filesystem_r36.5.2_aarch64.tbz2"
# NVIDIA's published SHA-1 list for the release (checked when reachable).
SHA_LIST_NAME=release_sha_hashes.txt

# SHA-256 pins. NVIDIA publishes only SHA-1 (above); these were recorded by
# independent projects that build on R36.5.2 (README.md, "Sources"):
#   BSP: seiggy/lucia-dotnet appliance.lock and avocado-linux/avocado-os PROVENANCE.md agree.
#   Sample rootfs: seiggy/lucia-dotnet appliance.lock (only needed for ROOTFS_SOURCE=sample).
BSP_SHA256=752326264c5e16826d3044a78e59ae06109467d37705143b94e664c91a471f47
ROOTFS_SHA256=077da9b27b1d3bc2247c2b73ce10cce880bdefe1f048d2a64df878d855a5b435
# SHA-1 from NVIDIA's release_sha_hashes.txt (as recorded by fatihaybsn/Orin-Stage).
BSP_SHA1=7ef67819e28b1dfb72bc6cb30d667b558d67063d
ROOTFS_SHA1=fb95b63ddf297a5f42613c94b2085eaa23e740f2

# Root filesystem: "minimal" builds NVIDIA's headless minimal Ubuntu with the
# BSP's tools/samplefs/nv_build_samplefs.sh (no desktop, small image: the
# release file must stay under GitHub's 2 GiB limit). "sample" uses NVIDIA's
# desktop sample rootfs and purges the desktop (larger; fallback only).
ROOTFS_SOURCE=minimal

# jetson-disk-image-creator.sh board. The "-super" configuration (MAXN SUPER
# power modes, JetPack 6.2+) is used when the BSP's image creator knows it;
# otherwise the build falls back to the plain devkit configuration and says so.
BOARD_PREFERRED=jetson-orin-nano-devkit-super
BOARD_FALLBACK=jetson-orin-nano-devkit

# readsb (ADS-B decoder), built from source in the chroot (no official apt
# repository exists; this is the upstream README's Debian-package method).
READSB_REPO=https://github.com/wiedehopf/readsb.git
READSB_TAG=v3.16.17
READSB_COMMIT=094720939c01943de82b14df6f42f67fff1cd514

# Tailscale's official apt repository for Ubuntu 22.04.
TAILSCALE_KEY_URL=https://pkgs.tailscale.com/stable/ubuntu/jammy.noarmor.gpg
TAILSCALE_LIST_URL=https://pkgs.tailscale.com/stable/ubuntu/jammy.tailscale-keyring.list

# The default account (password locked until the setup page sets one).
DEFAULT_USER=uapfinder
DEFAULT_HOSTNAME=uapfinder

# GitHub's limit for one release file.
MAX_RELEASE_BYTES=2147483648

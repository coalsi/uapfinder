// Tailscale access policy for UAP Finder (Admin console → Access controls).
//
// Edge nodes join with an auth key tagged tag:skynet-node and may reach only
// the server's ingest ports on the Mac Studio. Your own devices keep full
// access to each other. Replace the address in "hosts" with the Mac's
// Tailscale IP (shown in the admin console). If you already have a policy,
// merge these sections into it instead of replacing it.
{
  "hosts": {
    "uapfinder-server": "100.64.0.1",
  },

  "tagOwners": {
    "tag:skynet-node": ["autogroup:admin"],
  },

  "grants": [
    // You and other members of your tailnet: everything you own.
    {"src": ["autogroup:member"], "dst": ["autogroup:self"], "ip": ["*"]},
    {"src": ["autogroup:member"], "dst": ["tag:skynet-node"], "ip": ["*"]},
    {"src": ["autogroup:member"], "dst": ["uapfinder-server"], "ip": ["*"]},

    // Edge nodes: telemetry/heartbeats over UDP 9999 and HTTP 8000 (HTTPS
    // ingest fallback, command polling, clip uploads). Replies to these
    // flows (clip_request datagrams) are return traffic and are allowed.
    {"src": ["tag:skynet-node"], "dst": ["uapfinder-server"], "ip": ["udp:9999", "tcp:8000"]},
  ],

  // Allow `tailscale funnel` on your own (untagged) machines, which publishes
  // the API to the public internet over HTTPS.
  "nodeAttrs": [
    {"target": ["autogroup:member"], "attr": ["funnel"]},
  ],
}

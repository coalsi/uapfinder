{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo \"dependencies are installed per app by scripts/build-web.sh\"",
  "buildCommand": "bash scripts/build-web.sh",
  "outputDirectory": "site/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{dashboard,site,edge,docs,tools,deploy,server/tests,server/bench,common/tests,data}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}

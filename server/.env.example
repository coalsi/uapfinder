# SKY-NET server configuration. Copy to server/.env and load it with
#   skynet-server --env-file server/.env serve
# (variables already set in the environment win). On Vercel, set the same
# variables in Project Settings -> Environment Variables.

# --- required ----------------------------------------------------------------
# Master key all node keys are derived from (>= 32 chars): skynet-server keygen
SKYNET_MASTER_KEY=
# Bearer token for admin endpoints (node registration, volunteer export).
SKYNET_ADMIN_TOKEN=

# --- deployment ------------------------------------------------------------------
# standalone (default; uvicorn + UDP) or vercel (set automatically when VERCEL=1).
#SKYNET_MODE=standalone
# Base URL nodes use for clip uploads, e.g. http://mac-studio:8000 on a tailnet
# or the https Funnel/Vercel URL. Strongly recommended for standalone servers.
#SKYNET_PUBLIC_URL=
# Origins allowed to call the API from a browser (comma separated), e.g. the
# Vercel site when the API is reached through Tailscale Funnel.
#SKYNET_CORS_ORIGINS=https://skynet.example.vercel.app
# Take client IPs (volunteer rate limit) from the last X-Forwarded-For entry.
# Default true in vercel mode; uvicorn already trusts proxies on 127.0.0.1.
#SKYNET_TRUST_PROXY=false

# --- standalone listeners ----------------------------------------------------------
#SKYNET_HTTP_HOST=0.0.0.0
#SKYNET_HTTP_PORT=8000
#SKYNET_UDP_HOST=0.0.0.0          # "::" for dual-stack IPv6 + IPv4
#SKYNET_UDP_PORT=9999             # 0 disables UDP ingest
# host:port nodes should send UDP to (returned by POST /api/v1/nodes).
#SKYNET_UDP_PUBLIC_ENDPOINT=mac-studio:9999
#SKYNET_UDP_RCVBUF=8388608        # capped by net.core.rmem_max / kern.ipc.maxsockbuf
#SKYNET_UDP_BATCH=64              # max datagrams processed per batch
# Worker processes (redis backend; Linux spreads UDP over them, macOS does not).
#SKYNET_WORKERS=1

# --- state -----------------------------------------------------------------------
# memory (single instance, fastest) or redis (shared; required on Vercel).
#SKYNET_STATE_BACKEND=memory
# redis:// or rediss:// (TLS, e.g. Upstash). Falls back to REDIS_URL, KV_URL.
#SKYNET_REDIS_URL=redis://127.0.0.1:6379/0
#SKYNET_REDIS_PREFIX=skynet:

# --- database (optional: PostGIS history, volunteers) ---------------------------------
# Falls back to DATABASE_URL, POSTGRES_URL. Without it /health reports db=disabled
# and the volunteer endpoints answer 503.
#SKYNET_DATABASE_URL=postgresql://user:pass@host/db
# Direct (non-pooled) URL for `skynet-server migrate` on Neon; falls back to
# DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING.
#SKYNET_DATABASE_URL_UNPOOLED=
#SKYNET_DB_BATCH_MS=500           # standalone write batching
#SKYNET_DB_STATEMENT_CACHE=       # empty = automatic (0 behind a pooler)
#SKYNET_STORE_DETECTIONS=false    # raw detections table (~860 M rows/day at 10k msg/s)

# --- clip storage ---------------------------------------------------------------------
# local (standalone disk), s3 (any S3-compatible store; required on Vercel) or none.
#SKYNET_STORAGE=local
#SKYNET_STORAGE_DIR=data/clips
#SKYNET_MAX_CLIP_BYTES=536870912
#SKYNET_S3_BUCKET=
#SKYNET_S3_ACCESS_KEY_ID=         # falls back to AWS_ACCESS_KEY_ID
#SKYNET_S3_SECRET_ACCESS_KEY=     # falls back to AWS_SECRET_ACCESS_KEY
#SKYNET_S3_REGION=auto            # "auto" for Cloudflare R2; falls back to AWS_REGION
#SKYNET_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS
#SKYNET_S3_PATH_STYLE=            # default: true with a custom endpoint
#SKYNET_S3_PREFIX=clips/
#SKYNET_S3_PUBLIC_URL=            # public bucket URL; otherwise presigned 1 h downloads
#SKYNET_S3_VERIFY_UPLOADS=true    # HEAD the object on /complete

# --- matching and tracking ------------------------------------------------------------
#SKYNET_MATCH_RADIUS_MILES=80
#SKYNET_MATCH_WINDOW_MS=50
#SKYNET_INTERP_MAX_GAP_MS=250
#SKYNET_MATCH_MAX_RAYS=8
#SKYNET_DETECTION_RETENTION_S=5
#SKYNET_ANGULAR_SIGMA_DEG=0.05
#SKYNET_GATE_K_SIGMA=3
#SKYNET_GATE_MISS_FLOOR_M=30
#SKYNET_GATE_MIN_PARALLAX_DEG=1
#SKYNET_TRACK_LINK_TTL_S=30
#SKYNET_TRACK_EVENT_INTERVAL_MS=1000
#SKYNET_TRACK_RETENTION_H=6
#SKYNET_CLIP_WINDOW_S=5           # clip_request covers match time +- this

# --- protocol and misc ------------------------------------------------------------------
#SKYNET_FRESHNESS_S=10
#SKYNET_NODE_ACTIVE_S=60
#SKYNET_ALLOW_UNSIGNED=false      # INSECURE development switch: accept unsigned messages
#SKYNET_PUBLIC_LOCATION_DECIMALS=2
#SKYNET_EVENTS_MAXLEN=10000
#SKYNET_LIVE_POLL_MS=500          # redis event stream polling for WS /live (1000 on Vercel)
#SKYNET_WS_MAX_S=                 # close live sockets after this (280 on Vercel)
#SKYNET_VOLUNTEER_RATE_PER_HOUR=5
#SKYNET_LOG_LEVEL=info
